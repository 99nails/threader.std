// Версия библиотеки threader-std @VERSION4@
#define THREADER_STD_VERSION_MAJOR @VER_MAJ@
#define THREADER_STD_VERSION_MINOR @VER_MIN@
#define THREADER_STD_VERSION_PATCH @VER_PAT@
#define THREADER_STD_VERSION_BUILD @VER_BLD@
#define THREADER_STD_VERSION @VERSION@
#define THREADER_STD_VERSION_4 @VERSION4@

#define VERSION(MAJOR, MINOR, PATCH, BUILD) MAJOR * 256 * 256 *256 + MINOR * 256 *256 + PATCH * 256 + BUILD;

constexpr char THREADER_STD_VERSION_STRING[] = "@VERSION@";
constexpr char THREADER_STD_VERSION_4_STRING[] = "@VERSION4@";
constexpr int THREADER_STD_VERSION_INT = VERSION(@VER_MAJ@, @VER_MIN@, @VER_PAT@, @VER_BLD@);
